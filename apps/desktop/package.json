{
  "name": "@zastava/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "ZASTAVA desktop app: starts the supervisor and opens the UI",
  "type": "commonjs",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "build": "tsc -p tsconfig.build.json",
    "start": "electron ."
  },
  "dependencies": {
    "@zastava/contracts": "workspace:*",
    "@zastava/supervisor": "workspace:*"
  },
  "devDependencies": {
    "electron": "^44.5.1"
  }
}
