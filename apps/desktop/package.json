{
  "name": "@yugotool/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "YugoTool desktop app: starts the supervisor and opens the UI",
  "type": "commonjs",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "build": "tsc -p tsconfig.build.json",
    "start": "electron .",
    "stage": "node scripts/stage.mjs",
    "dist": "node scripts/dist.mjs --arch arm64 --arch x64",
    "dist:dir": "node scripts/dist.mjs --dir",
    "icon": "NODE_PATH=../worker/node_modules node build/render.cjs"
  },
  "dependencies": {
    "@yugotool/contracts": "workspace:*",
    "@yugotool/supervisor": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "26.15.3"
  },
  "productName": "YugoTool"
}
