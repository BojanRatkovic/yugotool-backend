{
  "name": "zastava-backend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:temporal": "temporal server start-dev --db-filename .temporal.db",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "db:generate": "pnpm --filter @zastava/db run db:generate",
    "db:migrate": "pnpm --filter @zastava/db run db:migrate"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.27.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild",
      "protobufjs",
      "@temporalio/core-bridge",
      "@embedded-postgres/darwin-arm64",
      "@embedded-postgres/darwin-x64",
      "electron"
    ]
  }
}
